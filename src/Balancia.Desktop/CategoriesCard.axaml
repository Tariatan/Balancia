<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Balancia.Desktop.CategoriesCard">
  <Border Classes="card" Padding="15">
    <Grid RowDefinitions="Auto,*" RowSpacing="6">
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
        <TextBlock x:Name="CategoriesHeading" Classes="title" Grid.Column="0" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="3">
          <Button x:Name="CategoryAddButton" Classes="icon" Content="+" />
          <Button x:Name="CategorySelectAllButton" Classes="icon" Content="▣" />
          <Button x:Name="CategoryArchiveButton" Classes="icon" Content="🗎" />
          <Button x:Name="CategoryRemoveButton" Classes="icon" Content="🗑" />
        </StackPanel>
      </Grid>
      <ListBox x:Name="CategoriesList" Grid.Row="1" Classes="compact-list panel-list" />
    </Grid>
  </Border>
</UserControl>
