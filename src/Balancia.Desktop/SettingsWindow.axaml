<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Balancia.Desktop.SettingsWindow"
        Icon="avares://Balancia.Desktop/Balancia.ico"
        ShowInTaskbar="False"
        Width="600" Height="620" MinWidth="600" MinHeight="620" MaxWidth="600" MaxHeight="620"
        CanResize="False"
        WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="*,Auto">
    <ScrollViewer Grid.Row="0">
      <StackPanel Margin="24" Spacing="12">
        <TextBlock x:Name="heading" FontSize="24" FontWeight="SemiBold" />
        <StackPanel Orientation="Horizontal" Spacing="12">
          <TextBlock x:Name="languageLabel" VerticalAlignment="Center" />
          <ComboBox x:Name="languagePicker" Width="170" />
        </StackPanel>
        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="7" ColumnSpacing="12">
          <Button x:Name="databaseButton" Grid.Row="0" Grid.Column="0" />
          <TextBlock x:Name="databaseText" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" />
          <Button x:Name="backupButton" Grid.Row="1" Grid.Column="0" />
          <TextBlock x:Name="backupText" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" />
          <Button x:Name="snapshotButton" Grid.Row="2" Grid.Column="0" />
          <TextBlock x:Name="snapshotText" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" />
        </Grid>
        <Separator Margin="0,4" />
        <TextBlock x:Name="encryptionHeading" FontWeight="SemiBold" />
        <TextBlock x:Name="encryptionStatus" TextWrapping="Wrap" />
        <Button x:Name="encryptionButton" HorizontalAlignment="Left" />
        <Separator Margin="0,4" />
        <TextBlock x:Name="dataTransferHeading" FontWeight="SemiBold" />
        <StackPanel Spacing="0">
          <WrapPanel>
            <Button x:Name="importCsvButton" Margin="0,10,10,10" />
            <Button x:Name="exportCsvButton" Margin="0,10,10,10" />
          </WrapPanel>
          <WrapPanel>
            <Button x:Name="restoreSnapshotButton" Margin="0,10,10,10" />
            <Button x:Name="exportSnapshotButton" Margin="0,10,10,10" />
          </WrapPanel>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="24,0,24,24">
      <Button x:Name="closeButton" IsCancel="True" HorizontalAlignment="Left" />
      <TextBlock x:Name="versionText" Grid.Column="1" FontSize="12" Foreground="#71838D" VerticalAlignment="Center" />
    </Grid>
  </Grid>
</Window>
