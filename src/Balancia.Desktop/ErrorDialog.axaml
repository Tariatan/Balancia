<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Balancia.Desktop.ErrorDialog"
        Icon="avares://Balancia.Desktop/Balancia.ico"
        ShowInTaskbar="False"
        Width="520" Height="260"
        WindowStartupLocation="CenterOwner">
  <StackPanel Spacing="16" Margin="24">
    <TextBlock x:Name="heading" FontSize="20" FontWeight="SemiBold" />
    <TextBlock x:Name="messageText" TextWrapping="Wrap" />
    <Button x:Name="closeButton" IsDefault="True" IsCancel="True" />
  </StackPanel>
</Window>
