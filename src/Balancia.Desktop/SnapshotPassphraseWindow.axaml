<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Balancia.Desktop.SnapshotPassphraseWindow"
        Width="530" Height="400" CanResize="False" ShowInTaskbar="False"
        Icon="avares://Balancia.Desktop/Balancia.ico" WindowStartupLocation="CenterOwner"
        Opened="OnOpened" Closed="OnClosed">
  <StackPanel Margin="24" Spacing="12">
    <TextBlock x:Name="Heading" FontSize="23" FontWeight="SemiBold" />
    <TextBlock x:Name="Explanation" TextWrapping="Wrap" />
    <Grid ColumnDefinitions="*,Auto">
      <TextBlock x:Name="PassphraseLabel" VerticalAlignment="Center" />
      <ToggleButton x:Name="ShowPassphrase" Grid.Column="1" Click="OnShowPassphrase"
                    Width="36" Height="32" Padding="4" HorizontalContentAlignment="Center">
        <Grid Width="24" Height="24">
          <TextBlock Text="👁" FontFamily="Segoe UI Symbol" FontSize="20"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
          <Line x:Name="EyeSlash" StartPoint="3,21" EndPoint="21,3"
                Stroke="{Binding Foreground, ElementName=ShowPassphrase}" StrokeThickness="2"
                IsVisible="False" IsHitTestVisible="False" />
        </Grid>
      </ToggleButton>
    </Grid>
    <TextBox x:Name="Passphrase" PasswordChar="●" />
    <TextBlock x:Name="ConfirmLabel" />
    <TextBox x:Name="Confirmation" PasswordChar="●" />
    <TextBlock x:Name="Error" Foreground="{DynamicResource Palette.Error}" TextWrapping="Wrap" />
    <StackPanel Orientation="Horizontal" Spacing="12">
      <Button x:Name="Accept" IsDefault="True" Click="OnAccept" />
      <Button x:Name="Cancel" IsCancel="True" Click="OnCancel" />
    </StackPanel>
  </StackPanel>
</Window>
