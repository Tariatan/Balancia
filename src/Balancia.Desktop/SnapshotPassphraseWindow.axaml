<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Balancia.Desktop.SnapshotPassphraseWindow"
        Width="530" Height="480" CanResize="False" ShowInTaskbar="False"
        Icon="avares://Balancia.Desktop/Balancia.ico" WindowStartupLocation="CenterOwner"
        Opened="OnOpened" Closed="OnClosed">
  <StackPanel Margin="24" Spacing="12">
    <TextBlock x:Name="Heading" FontSize="23" FontWeight="SemiBold" />
    <TextBlock x:Name="Explanation" TextWrapping="Wrap" />
    <TextBlock x:Name="PassphraseLabel" />
    <TextBox x:Name="Passphrase" PasswordChar="●" />
    <TextBlock x:Name="ConfirmLabel" />
    <TextBox x:Name="Confirmation" PasswordChar="●" />
    <TextBlock x:Name="Error" Foreground="DarkRed" TextWrapping="Wrap" />
    <StackPanel Orientation="Horizontal" Spacing="12">
      <Button x:Name="Accept" IsDefault="True" Click="OnAccept" />
      <Button x:Name="Cancel" IsCancel="True" Click="OnCancel" />
    </StackPanel>
  </StackPanel>
</Window>
