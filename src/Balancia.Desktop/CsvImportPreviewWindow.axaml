<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Balancia.Desktop.CsvImportPreviewWindow"
        Icon="avares://Balancia.Desktop/Balancia.ico"
        ShowInTaskbar="False"
        Width="700" Height="650" MinWidth="500" MinHeight="350"
        WindowStartupLocation="CenterOwner">
  <ScrollViewer>
    <StackPanel Margin="20" Spacing="12">
      <TextBlock x:Name="messageText" TextWrapping="Wrap" Foreground="#344D44" />
      <TextBlock x:Name="errorText" Foreground="DarkRed" />
      <WrapPanel>
        <Button x:Name="applyButton" Margin="0,10,10,10" />
        <Button x:Name="cancelButton" Margin="0,10,10,10" />
      </WrapPanel>
    </StackPanel>
  </ScrollViewer>
</Window>
