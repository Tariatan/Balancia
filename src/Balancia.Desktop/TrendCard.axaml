<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Balancia.Desktop"
             x:Class="Balancia.Desktop.TrendCard">
  <Border x:Name="TrendPanelBorder" Classes="card" Padding="15,8">
    <StackPanel Spacing="4">
      <TextBlock x:Name="TrendIntervalLabel" Height="16" Classes="muted" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
      <local:FlowChart x:Name="TrendChart" />
    </StackPanel>
  </Border>
</UserControl>
