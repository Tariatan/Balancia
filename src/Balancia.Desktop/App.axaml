<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Balancia.Desktop"
             x:Class="Balancia.Desktop.App" RequestedThemeVariant="Light">
  <Application.DataTemplates>
    <DataTemplate DataType="{x:Type local:ChartTooltipData}" x:DataType="local:ChartTooltipData">
      <StackPanel Grid.IsSharedSizeScope="True">
        <TextBlock Text="{Binding Heading}" Margin="0,0,0,8" />
        <ItemsControl ItemsSource="{Binding Rows}" HorizontalAlignment="Stretch">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="4" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="local:ChartTooltipRow">
              <Grid ColumnSpacing="18">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" SharedSizeGroup="TooltipAmounts" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" Foreground="{Binding Foreground}" FontWeight="Bold" />
                <TextBlock Grid.Column="1" Text="{Binding Amount}" Foreground="{Binding Foreground}"
                           FontWeight="Bold" HorizontalAlignment="Right" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </DataTemplate>
  </Application.DataTemplates>
  <Application.Styles>
    <FluentTheme />
    <Style Selector="TextBox">
      <Setter Property="Foreground" Value="#71838D" />
      <Setter Property="SelectionBrush" Value="#3989A7" />
      <Setter Property="SelectionForegroundBrush" Value="White" />
      <Setter Property="BorderBrush" Value="#DCE6EB" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="CheckBox.compact-filter-checkbox /template/ Border#NormalRectangle">
      <Setter Property="RenderTransform" Value="scale(0.8)" />
    </Style>
    <Style Selector="CheckBox.compact-filter-checkbox /template/ Viewbox">
      <Setter Property="RenderTransform" Value="scale(0.8)" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="Foreground" Value="#71838D" />
      <Setter Property="BorderBrush" Value="#DCE6EB" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="AutoCompleteBox">
      <Setter Property="Foreground" Value="#71838D" />
      <Setter Property="BorderBrush" Value="#DCE6EB" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="CalendarDatePicker">
      <Setter Property="Foreground" Value="#71838D" />
      <Setter Property="BorderBrush" Value="#DCE6EB" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="CalendarDatePicker /template/ Button#PART_Button">
      <Setter Property="Opacity" Value="0.55" />
    </Style>
    <Style Selector="AutoCompleteBox TextBox">
      <Setter Property="SelectionBrush" Value="#3989A7" />
      <Setter Property="SelectionForegroundBrush" Value="White" />
    </Style>
    <Style Selector="CalendarDatePicker /template/ Calendar#PART_Calendar">
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="CalendarDatePicker /template/ CalendarItem#PART_CalendarItem">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="MinWidth" Value="238" />
      <Setter Property="MinHeight" Value="190" />
    </Style>
    <Style Selector="CalendarDatePicker /template/ CalendarItem#PART_CalendarItem /template/ Grid#PART_MonthView">
      <Setter Property="MinHeight" Value="190" />
    </Style>
    <Style Selector="CalendarDatePicker /template/ CalendarItem#PART_CalendarItem /template/ Grid">
      <Setter Property="MinWidth" Value="238" />
      <Setter Property="MinHeight" Value="190" />
    </Style>
    <Style Selector="CalendarDatePicker /template/ CalendarItem#PART_CalendarItem CalendarDayButton">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="MinWidth" Value="30" />
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="CalendarDatePicker /template/ CalendarItem#PART_CalendarItem CalendarButton">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="MinWidth" Value="30" />
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ComboBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#3989A7" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#263989A7" />
      <Setter Property="Foreground" Value="#263C48" />
    </Style>
    <Style Selector="ListBoxItem:selected:not(:focus) /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#263989A7" />
      <Setter Property="Foreground" Value="#263C48" />
    </Style>
    <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#303989A7" />
      <Setter Property="Foreground" Value="#263C48" />
    </Style>
    <Style Selector="ListBoxItem:selected:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#403989A7" />
      <Setter Property="Foreground" Value="#263C48" />
    </Style>
    <Style Selector="ListBox.compact-list ListBoxItem">
      <Setter Property="Padding" Value="8,0" />
    </Style>
  </Application.Styles>
</Application>
