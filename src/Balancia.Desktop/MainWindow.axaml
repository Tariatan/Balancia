<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Balancia.Desktop"
        x:Class="Balancia.Desktop.MainWindow"
        Title="Balancia" Width="1440" Height="1280" MinWidth="1280" MinHeight="800"
        Background="#F6F8FA" WindowStartupLocation="CenterScreen"
        Icon="avares://Balancia.Desktop/Balancia.ico">
  <Window.Styles>
    <Style Selector="Button">
      <Setter Property="Background" Value="#E7F2F6" />
      <Setter Property="Foreground" Value="#263C48" />
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#D5EAF1" />
    </Style>
    <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#BDDDE9" />
    </Style>
    <Style Selector="Button.icon">
      <Setter Property="Width" Value="30" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.filter">
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="WrapPanel.filters > :is(Control)">
      <Setter Property="Margin" Value="0,2,7,2" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#DCE6EB" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="TextBlock.title">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#263C48" />
      <Setter Property="Margin" Value="0,0,0,10" />
    </Style>
    <Style Selector="TextBlock.heading">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#263C48" />
      <Setter Property="Margin" Value="0,0,0,10" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="#71838D" />
    </Style>
    <Style Selector="TextBlock.column-header">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="#71838D" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="Margin" Value="0,0,30,0" />
    </Style>
    <Style Selector="TextBlock.total-label">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="Foreground" Value="#71838D" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.total-value">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#263C48" />
    </Style>
    <Style Selector="ListBox.panel-list">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
  </Window.Styles>
  <Grid RowDefinitions="Auto,*">
    <Border Background="#1B303D" Padding="18,9">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="Balancia" VerticalAlignment="Center" FontSize="19" FontWeight="Bold" Foreground="White" />
        <TextBlock x:Name="AppVersionText" Grid.Column="1" FontSize="12" Foreground="#71838D" VerticalAlignment="Center" />
      </Grid>
    </Border>
    <ContentControl x:Name="Overview" Grid.Row="1" Margin="24,0,24,14" IsVisible="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
      <Grid x:Name="OverviewRoot" RowDefinitions="Auto,Auto,*" RowSpacing="11">

        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto">
          <TextBlock x:Name="SummaryLabel" Grid.Column="0" FontSize="12" Foreground="#FFB95D4D" VerticalAlignment="Center" />
          <TextBlock x:Name="OverviewStatus" Grid.Column="1" Classes="muted" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" />
          <Button x:Name="SettingsButton" Classes="icon" Grid.Column="2" Content="⚙" VerticalAlignment="Center" />
        </Grid>

        <Border Classes="card" Grid.Row="1" Padding="10">
          <Grid ColumnDefinitions="*,Auto">
            <WrapPanel Classes="filters">
              <Button x:Name="FilterButtonAll" Classes="filter" Content="All" MinWidth="50" />
              <Button x:Name="FilterButtonToday" Classes="filter" Content="Today" MinWidth="70" />
              <Button x:Name="FilterButtonWeek" Classes="filter" Content="Week" MinWidth="70" />
              <Button x:Name="FilterButtonMonth" Classes="filter" Content="Month" MinWidth="70" />
              <Button x:Name="FilterButtonYear" Classes="filter" Content="Year" MinWidth="50" />
              <Button x:Name="FilterButtonLast30Days" Classes="filter" Content="Last 30 days" MinWidth="100" />
              <local:LocalizedCalendarDatePicker x:Name="FilterFrom" Width="110" SelectedDateFormat="Custom" CustomDateFormatString="yyyy-MM-dd" FontSize="13" />
              <local:LocalizedCalendarDatePicker x:Name="FilterTo" Width="110" SelectedDateFormat="Custom" CustomDateFormatString="yyyy-MM-dd" FontSize="13" />
              <TextBox x:Name="FilterSearch" Width="150" Margin="0,2,0,2" />
              <Button x:Name="FilterClearSearch" Content="×" Width="28" Height="34" Padding="0" FontSize="17" Background="Transparent" Foreground="#71838D" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" VerticalAlignment="Center" />
              <TextBox x:Name="FilterMinimum" Width="115" />
              <TextBox x:Name="FilterMaximum" Width="110" />
            </WrapPanel>
            <Button x:Name="FilterClearAll" Classes="icon" Grid.Column="1" Content="🗑" FontSize="16" VerticalAlignment="Center" />
          </Grid>
        </Border>

        <Grid Grid.Row="2" ColumnDefinitions="0.65*,0.44*,0.46*,1.4*,1.5*" RowDefinitions="Auto,*" RowSpacing="11" ColumnSpacing="11">

          <local:AccountsCard x:Name="AccountsCard" Grid.Column="0" />

          <Grid Grid.Row="0" Grid.Column="1" RowDefinitions="*,*" RowSpacing="6">
            <local:StatCard x:Name="IncomeCard" Grid.Row="0" Foreground="#2C8B6D" />
            <local:StatCard x:Name="ExpensesCard" Grid.Row="1" Foreground="#B95D4D" />
          </Grid>

          <Grid Grid.Row="0" Grid.Column="2" RowDefinitions="*,*" RowSpacing="6">
            <local:StatCard x:Name="AverageIncomeCard" Grid.Row="0" Foreground="#2C8B6D" />
            <local:StatCard x:Name="AverageExpensesCard" Grid.Row="1" Foreground="#B95D4D" />
          </Grid>

          <Border x:Name="TrendPanelBorder" Classes="card" Grid.Row="0" Grid.Column="3" Padding="15,8">
            <StackPanel Spacing="4">
              <TextBlock x:Name="TrendIntervalLabel" Height="16" Classes="muted" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
              <local:FlowChart x:Name="TrendChart" />
            </StackPanel>
          </Border>

          <Border Classes="card" Grid.Row="0" Grid.Column="4" Padding="15,8">
            <StackPanel Spacing="4">
              <Border Height="16" />
              <local:FlowChart x:Name="TimelineChart" />
            </StackPanel>
          </Border>

          <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5" ColumnDefinitions="0.6*,3.58*" ColumnSpacing="11">

            <local:CategoriesCard x:Name="CategoriesCard" Grid.Column="0" />

            <Grid Grid.Column="1" ColumnDefinitions="2.4*,1*" ColumnSpacing="11">

              <Border Classes="card" Grid.Column="0" Padding="15,15,15,5">
                <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="2">
                  <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                    <TextBlock x:Name="TransactionsHeading" Classes="heading" Grid.Column="0" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="3">
                      <Button x:Name="TransactionsAddButton" Classes="icon" Content="+" />
                      <Button x:Name="TransactionsRemoveButton" Classes="icon" Content="🗑" />
                    </StackPanel>
                  </Grid>
                  <Grid Grid.Row="1" ColumnDefinitions="120,120,200,130,*" MinHeight="31">
                    <TextBlock x:Name="TransactionsColumnDate" Grid.Column="0" Classes="column-header" />
                    <TextBlock x:Name="TransactionsColumnAmount" Grid.Column="1" Classes="column-header" TextAlignment="Right" />
                    <TextBlock x:Name="TransactionsColumnCategory" Grid.Column="2" Classes="column-header" />
                    <TextBlock x:Name="TransactionsColumnAccount" Grid.Column="3" Classes="column-header" />
                    <TextBlock x:Name="TransactionsColumnDescription" Grid.Column="4" Classes="column-header" />
                  </Grid>
                  <Grid Grid.Row="2">
                    <TextBlock x:Name="TransactionsEmpty" Classes="muted" FontSize="13" VerticalAlignment="Top" Margin="0,6,0,0" />
                    <ListBox x:Name="TransactionsList" Classes="panel-list" />
                  </Grid>
                  <WrapPanel Grid.Row="3">
                    <Button x:Name="TransactionsPreviousPage" Content="Previous page" Margin="0,10,10,10" />
                    <Button x:Name="TransactionsNextPage" Content="Next page" Margin="0,10,10,10" />
                  </WrapPanel>
                </Grid>
              </Border>

              <Grid Grid.Column="1" RowDefinitions="Auto,*" RowSpacing="11">

                <Border Classes="card" Grid.Row="0" Padding="15">
                  <StackPanel Spacing="1">
                    <TextBlock x:Name="CategoryHeading" Classes="heading" Margin="0,0,0,20" />
                    <StackPanel x:Name="CategoryBody" Spacing="1" />
                  </StackPanel>
                </Border>

                <local:RemindersCard x:Name="RemindersCard" Grid.Row="1" />
              </Grid>
            </Grid>
          </Grid>
        </Grid>
      </Grid>
    </ContentControl>
  </Grid>
</Window>
