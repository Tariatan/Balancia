<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Balancia.Desktop"
        x:Class="Balancia.Desktop.MainWindow"
        Title="Balancia" Width="1440" Height="1280" MinWidth="1280" MinHeight="800"
        Background="#F6F8FA" WindowStartupLocation="CenterScreen"
        Icon="avares://Balancia.Desktop/Balancia.ico">
  <Window.Styles>
    <Style Selector="Button">
      <Setter Property="Background" Value="#E7F2F6" />
      <Setter Property="Foreground" Value="#263C48" />
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#D5EAF1" />
    </Style>
    <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#BDDDE9" />
    </Style>
    <Style Selector="Button.icon">
      <Setter Property="Width" Value="30" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#DCE6EB" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="TextBlock.title">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#263C48" />
      <Setter Property="Margin" Value="0,0,0,10" />
    </Style>
    <Style Selector="TextBlock.heading">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#263C48" />
      <Setter Property="Margin" Value="0,0,0,10" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="#71838D" />
    </Style>
    <Style Selector="TextBlock.column-header">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="#71838D" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="Margin" Value="0,0,30,0" />
    </Style>
    <Style Selector="TextBlock.total-label">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="Foreground" Value="#71838D" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.total-value">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#263C48" />
    </Style>
    <Style Selector="ListBox.panel-list">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
  </Window.Styles>
  <Grid RowDefinitions="Auto,*">
    <Border Background="#1B303D" Padding="18,9">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="Balancia" VerticalAlignment="Center" FontSize="19" FontWeight="Bold" Foreground="White" />
        <TextBlock x:Name="AppVersionText" Grid.Column="1" FontSize="12" Foreground="#71838D" VerticalAlignment="Center" />
      </Grid>
    </Border>
    <ContentControl x:Name="Overview" Grid.Row="1" Margin="24,0,24,14" IsVisible="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
      <local:OverviewView x:Name="OverviewPane" />
    </ContentControl>
  </Grid>
</Window>
