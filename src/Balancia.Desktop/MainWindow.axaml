<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Balancia.Desktop.MainWindow"
        Title="Balancia" Width="1120" Height="760" MinWidth="800" MinHeight="620"
        Background="#F3F5F4" WindowStartupLocation="CenterScreen">
  <Window.Styles>
    <Style Selector="Button">
      <Setter Property="Background" Value="#E4ECE7" />
      <Setter Property="Foreground" Value="#193D35" />
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#C8DDD1" />
      <Setter Property="Foreground" Value="#193D35" />
    </Style>
    <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#AFCDBC" />
      <Setter Property="Foreground" Value="#193D35" />
    </Style>
  </Window.Styles>
  <Grid ColumnDefinitions="210,*">
    <Border Background="#163D34" Padding="20,30">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,36">
          <TextBlock Text="Balancia" FontSize="27" FontWeight="Bold" Foreground="White" />
          <TextBlock Text="Your money, in view." Foreground="#C4D7CF" />
        </StackPanel>
        <TextBlock DockPanel.Dock="Bottom" Text="Windows · CHF&#10;Saved on this device" Foreground="#C4D7CF" />
        <StackPanel x:Name="Navigation" Spacing="10">
          <Button Content="Overview" HorizontalAlignment="Stretch" Click="ShowOverview" />
          <Button Content="Accounts" HorizontalAlignment="Stretch" Click="ShowAccounts" />
          <Button Content="Categories" HorizontalAlignment="Stretch" Click="ShowCategories" />
          <Button Content="Transactions" HorizontalAlignment="Stretch" Click="ShowTransactions" />
          <Button Content="Recurring payments" HorizontalAlignment="Stretch" Click="ShowRecurring" />
        </StackPanel>
      </DockPanel>
    </Border>
    <DockPanel Grid.Column="1" Margin="32">
      <TextBlock x:Name="PageTitle" DockPanel.Dock="Top" Text="Overview" FontSize="30" FontWeight="SemiBold" Foreground="#193D35" Margin="0,0,0,20" />
      <TextBlock x:Name="Status" DockPanel.Dock="Bottom" Text="Loading…" TextWrapping="Wrap" Margin="0,16,0,0" Foreground="#52645E" />
      <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="PageBody" Spacing="18" />
      </ScrollViewer>
    </DockPanel>
  </Grid>
</Window>
